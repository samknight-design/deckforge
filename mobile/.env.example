# Copy this file to mobile/.env.local and fill in the same values you already
# have in web/.env.local. Both apps connect to the same Supabase project.
#
# The anon key is *designed* to ship to clients — it's the public-facing
# Supabase key. RLS policies on the database control what each user can read
# or write. Never commit this file with real values; .env.local is gitignored.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
