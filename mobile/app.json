{
  "expo": {
    "name": "DeckForge",
    "slug": "deckforge",
    "scheme": "deckforge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.deckforge",
      "infoPlist": {
        "NSCameraUsageDescription": "DeckForge uses your camera to scan Magic: The Gathering cards. Images stay on your device unless you tap to Smart-Scan a card we can't identify locally."
      }
    },
    "android": {
      "package": "app.deckforge",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0a0e1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "DeckForge uses your camera to scan Magic: The Gathering cards. Images stay on-device unless Smart Scan is needed.",
          "enableFrameProcessors": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "packagingOptions": { "pickFirst": ["**/libreactnative.so"] }
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://deckforge-eta.vercel.app",
      "eas": {
        "projectId": "18abc667-8e81-47b3-b0b3-9980bc95741b"
      }
    },
    "owner": "arcaneflame"
  }
}
