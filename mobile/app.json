{
  "expo": {
    "name": "DeckForge",
    "slug": "deckforge",
    "scheme": "deckforge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.deckforge"
    },
    "android": {
      "package": "app.deckforge",
      "adaptiveIcon": {
        "backgroundColor": "#0a0e1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "DeckForge uses your camera to scan Magic cards. Images stay on your device unless you tap to Smart-Scan a card we can't identify locally."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://deckforge-eta.vercel.app"
    }
  }
}
