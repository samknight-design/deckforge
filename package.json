{
  "name": "deckforge",
  "version": "0.0.0",
  "private": true,
  "description": "DeckForge monorepo — web (Next.js PWA), mobile (Expo React Native), shared (pure JS libs).",
  "workspaces": [
    "web",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev": "npm --workspace=web run dev",
    "build": "npm --workspace=web run build",
    "start": "npm --workspace=web run start",
    "lint": "npm --workspace=web run lint",
    "mobile:start": "npm --workspace=mobile run start"
  }
}
